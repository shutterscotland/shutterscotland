---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Shutter Scotland | Connect & Book">
	<main style="background-color: #FAFAFA; min-height: 80vh;">
		
		<!-- Split Hero / Form Section -->
		<section style="display: flex; flex-direction: row; flex-wrap: wrap; width: 100%; border-bottom: 3px solid #0A0A0A; overflow: hidden;">
			
			<!-- Left Column: The Attitude / Info -->
			<div style="flex: 1 1 40%; min-width: 320px; padding: 48px; background-color: #0A0A0A; color: #FAFAFA; display: flex; flex-direction: column; justify-content: space-between; box-sizing: border-box; border-right: 3px solid #0A0A0A;">
				<div>
					<span style="font-family: 'Courier New', monospace; font-size: 12px; font-weight: bold; color: #FF4500; letter-spacing: 0.1em; text-transform: uppercase;">COMMS_04 // SECURE A SLOT</span>
					<h1 style="font-family: 'Arial Black', 'Impact', sans-serif; font-size: clamp(2rem, 3.5vw, 4rem); text-transform: uppercase; line-height: 0.95; letter-spacing: -0.04em; margin-top: 24px; margin-bottom: 24px;">
						LAUNCH A <br><span style="color: #FF4500;">REQUEST.</span>
					</h1>
					<p style="font-family: 'Courier New', monospace; font-size: 14px; color: #A1A1AA; line-height: 1.6; max-width: 400px; margin: 0 0 24px 0;">
						Tours run daily but group sizes are strictly limited to keep the training focused. Drop your details here to request a specific date. 
					</p>
					<p style="font-family: 'Courier New', monospace; font-size: 13px; color: #71717A; line-height: 1.6; max-width: 400px; margin: 0;">
						<strong style="color: #FAFAFA;">Beyonk Integration Note:</strong> Once our account onboarding is finalized, this manual intake form will be replaced instantly by the live booking grid overlay.
					</p>
				</div>

				<div style="padding-top: 40px; font-family: 'Courier New', monospace; font-size: 12px; color: #71717A;">
					LOC_EDINBURGH_OLD_TOWN // SCOTLAND
				</div>
			</div>

			<!-- Right Column: The Netlify Engine Form -->
			<div style="flex: 1 1 50%; min-width: 320px; padding: 48px; box-sizing: border-box; background-color: #FAFAFA; display: flex; flex-direction: column; justify-content: center;">
				
				<!-- The Netlify setup handles tracking automatically via 'data-netlify="true"' -->
				<form 
					name="shutter-scotland-booking" 
					method="POST" 
					data-netlify="true" 
					action="/success"
					style="display: flex; flex-direction: column; gap: 24px; width: 100%; max-width: 500px;"
				>
					<!-- Anti-spam honeypot field for security -->
					<input type="hidden" name="form-name" value="shutter-scotland-booking" />

					<div style="display: flex; flex-direction: column; gap: 8px;">
						<label style="font-family: 'Courier New', monospace; font-size: 13px; font-weight: bold; color: #0A0A0A;">[ 01 // OPERATOR NAME ]</label>
						<input type="text" name="name" required placeholder="e.g. John Doe" style="width: 100%; padding: 14px; border: 3px solid #0A0A0A; background-color: #FAFAFA; font-family: 'Courier New', monospace; font-size: 14px; box-sizing: border-box;" />
					</div>

					<div style="display: flex; flex-direction: column; gap: 8px;">
						<label style="font-family: 'Courier New', monospace; font-size: 13px; font-weight: bold; color: #0A0A0A;">[ 02 // COMMS LINK / EMAIL ]</label>
						<input type="email" name="email" required placeholder="e.g. john@example.com" style="width: 100%; padding: 14px; border: 3px solid #0A0A0A; background-color: #FAFAFA; font-family: 'Courier New', monospace; font-size: 14px; box-sizing: border-box;" />
					</div>

					<div style="display: flex; flex-direction: column; gap: 8px;">
						<label style="font-family: 'Courier New', monospace; font-size: 13px; font-weight: bold; color: #0A0A0A;">[ 03 // TARGET DATE & TIME ]</label>
						<input type="text" name="target-date" required placeholder="e.g. Saturday 20th June, 2:00 PM" style="width: 100%; padding: 14px; border: 3px solid #0A0A0A; background-color: #FAFAFA; font-family: 'Courier New', monospace; font-size: 14px; box-sizing: border-box;" />
					</div>

					<div style="display: flex; flex-direction: column; gap: 8px;">
						<label style="font-family: 'Courier New', monospace; font-size: 13px; font-weight: bold; color: #0A0A0A;">[ 04 // HARDWARE STATE / SMARTPHONE OR CAMERA? ]</label>
						<input type="text" name="hardware" placeholder="e.g. Fujifilm X-T30 or iPhone" style="width: 100%; padding: 14px; border: 3px solid #0A0A0A; background-color: #FAFAFA; font-family: 'Courier New', monospace; font-size: 14px; box-sizing: border-box;" />
					</div>

					<div style="padding-top: 12px;">
						<button type="submit" style="display: inline-block; width: 100%; font-family: 'Courier New', monospace; font-size: 14px; font-weight: bold; text-transform: uppercase; border: 3px solid #0A0A0A; background-color: #FF4500; color: #FAFAFA; padding: 16px; letter-spacing: 0.05em; box-shadow: 4px 4px 0px 0px #0A0A0A; cursor: pointer; transition: transform 0.1s ease;">
							[ TRANSMIT BOOKING REQUEST ]
						</button>
					</div>
				</form>

			</div>

		</section>

	</main>
</MainLayout>